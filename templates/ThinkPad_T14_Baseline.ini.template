 ; ==============================================================================
; LENOVO THINKBIOS-CONFIG BASELINE TEMPLATE (EXAMPLE)
; ==============================================================================
; Propósito: Plantilla de configuración de BIOS/UEFI para flotas Lenovo ThinkPad.
; Herramienta: Generado / Procesado vía Lenovo ThinkBios-Config PowerShell Module.
; Uso: Copiar este archivo a 'ThinkPad_T14_Baseline.ini', configurar los parámetros
;      necesarios y empaquetar mediante Lenovo Settings Encrypter antes de desplegar.
; ==============================================================================

[BIOSSETTINGS]
; --- Seguridad Criptográfica y Estado del Chip ---
SecurityChip=Enable                 ; Activa dTPM 2.0 / Pluton

; --- Arranque Seguro y Configuración UEFI ---
SecureBoot=Enable                   ; Habilita Secure Boot
UEFI/LegacyBoot=UEFI Only           ; Fuerza modo UEFI Puro (Sin soporte heredado)
CSMSupport=Disable                  ; Deshabilita Support Compatibility Module

; --- Control de Periféricos y Gestión Remota ---
WakeOnLAN=AC Only                   ; Permite encendido por red solo conectado a corriente
BootOrderLock=Enable                ; Bloquea la secuencia de arranque predefinida

; --- Virtualización de Hardware ---
VirtualizationTechnology=Enable     ; Habilita Intel VT-x / AMD-V

; ==============================================================================
; CREDENTIALS & SECURITY INJECTION
; ==============================================================================
; NOTA DE SEGURIDAD: Nunca ingrese contraseñas en texto plano dentro del repositorio.
; Para incluir la contraseña de Supervisor, compile este archivo usando la herramienta
; oficial 'Lenovo BIOS Configurator / Lenovo Settings Encrypter' para generar el 
; archivo final encriptado (.ini / .bin).
;
; SupervisorPassword=__YOUR_ENCRYPTED_PASSWORD_HASH_HERE__
